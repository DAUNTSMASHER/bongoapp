# Site URL for sitemap, robots, and Open Graph (required for correct sitemap in Search Console)
# NEXT_PUBLIC_APP_URL=https://bongochoti.com

# Google Analytics 4 - create property at analytics.google.com, get Measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console - verify ownership for indexing (Optional, for SEO)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# Facebook App - for "Post to Facebook Page" share (developers.facebook.com). Needs pages_show_list, pages_manage_posts.
# NEXT_PUBLIC_FACEBOOK_APP_ID=your_app_id

# Firebase (bongochoti) - config is in lib/firebase.ts; override with env if needed
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: AI logo (Profile) + better story headlines (Admin Enhance)
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxx

# Search videos (Admin Search & Add): Serper API key - free at serper.dev, 2,500 searches
# SERPER_API_KEY=your_serper_key

# Auto-browse APIs for story crawler (handles anti-bot, JS rendering):
# Firecrawl: firecrawl.dev – cloud scraping, returns clean HTML/markdown
# BROWSERCAT_API_KEY=your_browsercat_key
# FIRECRAWL_API_KEY=fc-your_firecrawl_key

# Adsterra Publisher API - fetch stats/placements (beta.publishers.adsterra.com → API). Server-side only.
# ADSTERRA_API_TOKEN=your_token_from_dashboard

# Vercel Blob – for hosting videos on your site (no redirect). Create store in Vercel → Storage.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Required for Vercel (Admin video/story crawl): Service Account JSON as single-line string.
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Copy the entire JSON and paste here (or set in Vercel Dashboard → Settings → Environment Variables)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# GitHub storage for crawled videos (avoids Firestore quota). Create PAT at github.com/settings/tokens (repo scope).
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_REPO=owner/repo (e.g. your-username/story-reading-app)
# GITHUB_BRANCH=main
# GITHUB_VIDEOS_PATH=data/crawled-videos.json
